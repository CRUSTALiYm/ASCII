{
  "name": "t-ascii",
  "description": "Программа для удобной загрузки и обновления корпоративных программ",
  "version": "0.1.0",
  "productName": "Конвертер ASCII",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "tauri:start": "tauri dev",
    "tauri:build:all": "npm run tauri:build:x64 && npm run tauri:build:x86 && npm run tauri:build:arm64 && npm run tauri:collect",
    "tauri:build:x64": "dotenv tauri build -- --target x86_64-pc-windows-msvc",
    "tauri:build:x86": "dotenv tauri build -- --target i686-pc-windows-msvc",
    "tauri:build:arm64": "dotenv tauri build -- --target aarch64-pc-windows-msvc",
    "tauri:collect": "node scripts/collect-tauri-artifacts.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@fontsource/manrope": "^5.3.0",
    "@primeng/themes": "^21.0.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "primeicons": "^8.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.22",
    "@tauri-apps/cli": "^2",
    "dotenv-cli": "^11.0.0",
    "typescript": "~5.9.3"
  }
}
