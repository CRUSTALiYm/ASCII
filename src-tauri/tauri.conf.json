{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-steam",
  "version": "0.1.0",
  "identifier": "com.t-steam.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/t-steam/browser"
  },
  "app": {
    "windows": [
      {
        "title": "t-steam",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ТМ-ТЕХНОЛОГИИ",
    "copyright": "Copyright © 2026 CRUSTALiYm.",
    "shortDescription": "Программа для удобной загрузки и обновления корпоративных программ",
    "longDescription": "Корпоративный клиент T-Steam, предназначенный для централизованной дистрибуции, установки и автоматического обновления рабочих приложений внутри компании.",
    "windows": {
      "signCommand": {
        "cmd": "node",
        "args": ["sign.js", "%1"]
      },
      "wix": {
        "language": "ru-RU",
        "upgradeCode": "07961c5b-e384-5196-8406-33096625b95b"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyODZCOTNERjdFOENEOTIKUldTU3plajNQYm1HUWc0REJqS2lkZ1pVSVRrOEY0OUlvb1BrSHJ6cWthMzZobUwvTFB3d3g3NWYK",
      "endpoints": ["localhost:5665"]
    }
  }
}
