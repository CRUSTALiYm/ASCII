{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-ascii",
  "version": "0.1.1",
  "identifier": "com.t-ascii.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/t-ascii/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Конвертер ASCII",
        "width": 800,
        "height": 600,
        "minWidth": 240,
        "minHeight": 120,
        "maxWidth": 1920,
        "maxHeight": 1200,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ТМ-ТЕХНОЛОГИИ",
    "copyright": "Copyright © 2026 CRUSTALiYm.",
    "shortDescription": "Программа для удобной загрузки и обновления корпоративных программ",
    "longDescription": "Корпоративный клиент t-ascii, предназначенный для централизованной дистрибуции, установки и автоматического обновления рабочих приложений внутри компании.",
    "windows": {
      "wix": {
        "language": "ru-RU",
        "upgradeCode": "07961c5b-e384-5196-8406-33096625b95b"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyODZCOTNERjdFOENEOTIKUldTU3plajNQYm1HUWc0REJqS2lkZ1pVSVRrOEY0OUlvb1BrSHJ6cWthMzZobUwvTFB3d3g3NWYK",
      "endpoints": ["localhost:5665"],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
