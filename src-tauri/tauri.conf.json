{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-ascii",
  "version": "0.1.2",
  "identifier": "com.t-ascii.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/t-ascii/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Конвертер ASCII",
        "width": 800,
        "height": 600,
        "minWidth": 240,
        "minHeight": 120,
        "maxWidth": 1920,
        "maxHeight": 1200,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/ico-x32.ico",
      "icons/ico-x128.ico",
      "icons/ico-x256.ico"
    ],
    "publisher": "CRUSTALiYm",
    "copyright": "Copyright © 2026 CRUSTALiYm.",
    "shortDescription": "Простой и удобный Десктопный конвертер изображений в ASCII",
    "longDescription": "Простой и удобный Десктопный конвертер изображений в ASCII.",
    "windows": {
      "wix": {
        "language": "ru-RU",
        "upgradeCode": "07961c5b-e384-5196-8406-33096625b95b"
      },
      "nsis": {
        "installerIcon": "icons/Package.ico",
        "uninstallerIcon": "icons/Uninstall.ico",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyODZCOTNERjdFOENEOTIKUldTU3plajNQYm1HUWc0REJqS2lkZ1pVSVRrOEY0OUlvb1BrSHJ6cWthMzZobUwvTFB3d3g3NWYK",
      "endpoints": [
        "https://github.com/CRUSTALiYm/ASCII/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
